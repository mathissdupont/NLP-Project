{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Controlled Turkish nominal example v0.1.0",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "id", "root_id", "pair_id", "root", "root_type", "surface", "segments", "morphemes", "features", "split", "validation_status", "screening_status", "source_id", "reviewers", "notes"],
  "$defs": {
    "identifier": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"},
    "nonblank": {"type": "string", "minLength": 1, "pattern": "\\S"}
  },
  "properties": {
    "schema_version": {"const": "0.1.0"},
    "id": {"$ref": "#/$defs/identifier"},
    "root_id": {"$ref": "#/$defs/identifier"},
    "pair_id": {"$ref": "#/$defs/identifier"},
    "root": {"$ref": "#/$defs/nonblank"},
    "root_type": {"enum": ["real", "nonce"]},
    "surface": {"$ref": "#/$defs/nonblank"},
    "segments": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/nonblank"}},
    "morphemes": {
      "type": "array",
      "uniqueItems": true,
      "items": {"enum": ["PL", "POSS_1SG", "POSS_2SG", "POSS_3SG", "POSS_1PL", "POSS_2PL", "POSS_3PL", "ACC", "DAT", "LOC", "ABL", "GEN"]}
    },
    "features": {
      "type": "object",
      "additionalProperties": false,
      "required": ["Number", "Case", "Possession", "Person[psor]", "Number[psor]"],
      "properties": {
        "Number": {"enum": ["Sing", "Plur"]},
        "Case": {"enum": ["Nom", "Acc", "Dat", "Loc", "Abl", "Gen"]},
        "Possession": {"enum": ["Yes", "No"]},
        "Person[psor]": {"enum": [null, "1", "2", "3"]},
        "Number[psor]": {"enum": [null, "Sing", "Plur"]}
      }
    },
    "split": {"enum": ["unassigned", "train", "dev", "test"]},
    "validation_status": {"enum": ["pending", "accepted", "rejected"]},
    "screening_status": {"enum": ["not_applicable", "pending", "passed", "rejected"]},
    "source_id": {"$ref": "#/$defs/identifier"},
    "reviewers": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/nonblank"}},
    "notes": {"type": "string"}
  }
}
